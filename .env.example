# ---- Required ---------------------------------------------------------------
# The address you open the app at (used in sign-in links and emails).
PUBLIC_URL=https://your-app.up.railway.app

# Claude: understands ideas, writes reports and plans. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Transcription. ElevenLabs is the main one (best with Hebrew and gives exact
# timestamps): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# OpenAI: search by meaning, plus backup transcription if ElevenLabs is down.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Your time zone (for digests and due dates), e.g. Asia/Jerusalem, Europe/London
TZ=UTC

# ---- Optional ---------------------------------------------------------------
# Where data is stored. On Railway, mount a volume at /data.
DATA_DIR=/data

# Email for digests and reminders, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Idea Bridge <ideas@example.com>

# Contact address included with push notifications (must be real for iPhones).
VAPID_SUBJECT=mailto:you@example.com

# Off-site backups to any S3-compatible storage (Cloudflare R2 is free up to 10 GB).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# Models (defaults are recommended).
CLAUDE_MODEL=claude-opus-5-5
ELEVENLABS_MODEL=scribe_v2
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
EMBEDDING_MODEL=text-embedding-3-large
